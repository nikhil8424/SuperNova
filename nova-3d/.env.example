# NOVA 3D - Environment Variables Configuration
NOVA_DATABASE_URL=sqlite:///data/nova3d.sqlite
NOVA_MAX_IMAGE_DIM=1600
NOVA_EXTRACTION_INTERVAL=0.5
NOVA_MIN_SHARPNESS=40.0
NOVA_COLMAP_EXE=colmap
NOVA_COLMAP_TIMEOUT=1800
NOVA_GS_ITERATIONS=4000
